<Window x:Class="DeskCal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Calendar" Height="650" Width="850" MinWidth="805"
        Icon="cal.ico"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        PreviewMouseDown="Window_PreviewMouseDown"
        StateChanged="Window_StateChanged"
        FontFamily="./Fonts/#Pretendard, Segoe UI, Malgun Gothic"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="MyWindowChrome"
                      CaptionHeight="60"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="12"/>
        <!-- 오른쪽 아래 크기 조절 점무늬(약 12px)가 전부 동작하도록 테두리 폭을 맞춤 (가장자리 10px 은 투명 여백) -->
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="AccentColor">#5AC8FA</Color>
        <Color x:Key="AccentSoftColor">#335AC8FA</Color>
        <Color x:Key="DangerColor">#FF5C5C</Color>
        <Color x:Key="DangerSoftColor">#33FF5C5C</Color>
        <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentSoftBrush"   Color="{StaticResource AccentSoftColor}"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="DangerSoftBrush"   Color="{StaticResource DangerSoftColor}"/>
        <SolidColorBrush x:Key="CardBackgroundDark"   Color="#1E2231"/>
        <SolidColorBrush x:Key="CardBackgroundDarker" Color="#181C28"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#2E3547"/>
        <SolidColorBrush x:Key="ScrollThumbBrush"     Color="#4A5270"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6B7599"/>

        <!-- 테마 브러시: 다크 값. 라이트 테마에서는 ApplyTheme 가 같은 역할의 밝은 값으로 바꿈 (Theme.cs) -->
        <SolidColorBrush x:Key="Th.CardBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="Th.CloseHover" Color="#40FF4444"/>
        <SolidColorBrush x:Key="Th.ClosePressed" Color="#70FF4444"/>
        <SolidColorBrush x:Key="Th.PopupBg" Color="#FF181C28"/>
        <SolidColorBrush x:Key="Th.SegSel" Color="#605AC8FA"/>
        <SolidColorBrush x:Key="Th.SegSelText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Th.Privacy" Color="#D49520"/>
        <SolidColorBrush x:Key="Th.PrivacyOn" Color="#B07818"/>
        <SolidColorBrush x:Key="Th.PrivacyHover" Color="#C08618"/>
        <SolidColorBrush x:Key="Th.PrivacyIcon" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Th.KnobStroke" Color="#00000000"/>
        <SolidColorBrush x:Key="Th_0EFFFFFF" Color="#0EFFFFFF"/>
        <SolidColorBrush x:Key="Th_12FFFFFF" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="Th_15FFFFFF" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="Th_18FFFFFF" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="Th_1AFFFFFF" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="Th_205AC8FA" Color="#205AC8FA"/>
        <SolidColorBrush x:Key="Th_20FFFFFF" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="Th_25FFFFFF" Color="#25FFFFFF"/>
        <SolidColorBrush x:Key="Th_26FFFFFF" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="Th_30FFFFFF" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="Th_38FFFFFF" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="Th_405AC8FA" Color="#405AC8FA"/>
        <SolidColorBrush x:Key="Th_5580A8D8" Color="#5580A8D8"/>
        <SolidColorBrush x:Key="Th_FF10141E" Color="#FF10141E"/>
        <SolidColorBrush x:Key="Th_FF1E2231" Color="#FF1E2231"/>
        <SolidColorBrush x:Key="Th_FF2E3547" Color="#FF2E3547"/>
        <SolidColorBrush x:Key="Th_FF2EC876" Color="#FF2EC876"/>
        <SolidColorBrush x:Key="Th_FF3A4058" Color="#FF3A4058"/>
        <SolidColorBrush x:Key="Th_FF4A5270" Color="#FF4A5270"/>
        <SolidColorBrush x:Key="Th_FF4EB8E8" Color="#FF4EB8E8"/>
        <SolidColorBrush x:Key="Th_FF5AC8FA" Color="#FF5AC8FA"/>
        <SolidColorBrush x:Key="Th_FF6E7694" Color="#FF6E7694"/>
        <SolidColorBrush x:Key="Th_FF7880A0" Color="#FF7880A0"/>
        <SolidColorBrush x:Key="Th_FF8A93B4" Color="#FF8A93B4"/>
        <SolidColorBrush x:Key="Th_FF9BA4C0" Color="#FF9BA4C0"/>
        <SolidColorBrush x:Key="Th_FFA0A8C4" Color="#FFA0A8C4"/>
        <SolidColorBrush x:Key="Th_FFA270FA" Color="#FFA270FA"/>
        <SolidColorBrush x:Key="Th_FFB0B8D0" Color="#FFB0B8D0"/>
        <SolidColorBrush x:Key="Th_FFC0D8F8" Color="#FFC0D8F8"/>
        <SolidColorBrush x:Key="Th_FFD0D6EA" Color="#FFD0D6EA"/>
        <SolidColorBrush x:Key="Th_FFE05050" Color="#FFE05050"/>
        <SolidColorBrush x:Key="Th_FFE06060" Color="#FFE06060"/>
        <SolidColorBrush x:Key="Th_FFE0E4F4" Color="#FFE0E4F4"/>
        <SolidColorBrush x:Key="Th_FFE8ECF8" Color="#FFE8ECF8"/>
        <SolidColorBrush x:Key="Th_FFFFC94D" Color="#FFFFC94D"/>
        <SolidColorBrush x:Key="Th_FFFFFFFF" Color="#FFFFFFFF"/>

        <LinearGradientBrush x:Key="TopBarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1C2030" Offset="0"/>
            <GradientStop Color="#161A26" Offset="0.5"/>
            <GradientStop Color="#12151E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E2338" Offset="0"/>
            <GradientStop Color="#1A1F32" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CalendarBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#12151E" Offset="0"/>
            <GradientStop Color="#0C0E16" Offset="1"/>
        </LinearGradientBrush>

        <!-- ToggleSwitch 스타일 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Background"   Value="{DynamicResource Th_FF2E3547}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource Th_FF3A4058}"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <!-- 설정 줄 높이(40)에 맞춘 작은 스위치 -->
                        <Grid Width="42" Height="24">
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    CornerRadius="12" BorderThickness="1"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                            <Ellipse x:Name="Knob" Width="20" Height="20"
                                     HorizontalAlignment="Left" Margin="2,2,2,2">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EAF0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.35" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="20,2,2,2" Duration="0:0:0.18"
                                                                DecelerationRatio="0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="2,2,2,2" Duration="0:0:0.18"
                                                                DecelerationRatio="0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernCheckBox 스타일 -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Th_FF9BA4C0}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Height="20" Width="20">
                                <Border x:Name="Border" CornerRadius="5" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource Th_FF3A4058}" Background="{DynamicResource Th_FF1E2231}"/>
                                <Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,4"
                                      Stroke="White" StrokeThickness="2.3"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border"    Property="Background"  Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Border"    Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility"  Value="Visible"/>
                                <Setter Property="Foreground"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Th_5580A8D8}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 스크롤바 스타일 -->
        <Style x:Key="ModernScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="6" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="{DynamicResource ScrollThumbBrush}"
                                           Style="{DynamicResource ScrollThumbs}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"   Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Thumb" Property="Background"
                                        Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="Transparent"/>
                            <Border CornerRadius="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Grid.Column="0" Margin="{TemplateBinding Padding}" Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                AutomationProperties.AutomationId="VerticalScrollBar"
                                Cursor="Arrow" Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Style="{DynamicResource ModernScrollBarStyle}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                AutomationProperties.AutomationId="HorizontalScrollBar"
                                Cursor="Arrow" Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}" Minimum="0"
                                Orientation="Horizontal" Grid.Row="1"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Style="{DynamicResource ModernScrollBarStyle}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernBtn -->
        <!-- 툴바 아이콘 글꼴 (WPF 는 컬러 이모지를 흑백으로 그리므로 아이콘 글꼴 + 색 지정). Win10 은 MDL2 로 대체 -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Foreground"        Value="{DynamicResource Th_FFA0A8C4}"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Padding"           Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Th_18FFFFFF}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Th_FFE0E4F4}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Th_30FFFFFF}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Th_FFFFFFFF}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 설정 패널: 구역 제목 + 유리 카드 한 장 + 가는 선으로 나눈 줄. 값 조절은 모두 오른쪽 끝에 맞춤 ══ -->
        <Style x:Key="SettingSectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin"      Value="4,16,0,7"/>
        </Style>
        <Style x:Key="SettingSectionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Th_FF8A93B4}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Th.CardBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Th_12FFFFFF}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="12,0"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Th_FFB0B8D0}"/>
            <Setter Property="Margin"     Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SettingDivider" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Th_0EFFFFFF}"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10.5"/>
            <Setter Property="Foreground"   Value="{DynamicResource Th_FF6E7694}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingSwitch" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <!-- 여러 칸 중 하나 고르기 (툴바 월간|주간 탭과 같은 모양) -->
        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource Th_1AFFFFFF}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style x:Key="SegmentToggle" TargetType="ToggleButton">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Th_FFA0A8C4}"/>
            <Setter Property="MinWidth"   Value="26"/>
            <Setter Property="Height"     Value="24"/>
            <Setter Property="Padding"    Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tab" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="{DynamicResource Th_18FFFFFF}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Th_FFE0E4F4}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="{DynamicResource Th.SegSel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Th.SegSelText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource Th_FFA0A8C4}"/>
            <Setter Property="Width"      Value="24"/>
            <Setter Property="Height"     Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th_18FFFFFF}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Th_FFE0E4F4}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th_30FFFFFF}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 얇은 슬라이더: 채운 쪽은 강조색, 손잡이는 흰 원 -->
        <Style x:Key="SliderBarButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderKnob" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="knob" Width="14" Height="14" Fill="#FFFFFF" StrokeThickness="1" Stroke="{DynamicResource Th.KnobStroke}">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.4" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="StrokeThickness" Value="2"/>
                                <Setter TargetName="knob" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="knob" Property="StrokeThickness" Value="2"/>
                                <Setter TargetName="knob" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource SliderBarButton}" Background="{DynamicResource AccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource SliderBarButton}" Background="{DynamicResource Th_FF2E3547}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderKnob}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource Th_FF10141E}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Th_FFD0D6EA}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Th_FF2E3547}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource Th_FF5AC8FA}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Th_FF4A5270}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Th_FF5AC8FA}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="21*"/>
            <ColumnDefinition Width="62*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F1119" Offset="0"/>
                <GradientStop Color="#0B0D14" Offset="0.45"/>
                <GradientStop Color="#080A10" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border x:Name="MainBorder" CornerRadius="18"
                BorderBrush="{DynamicResource Th_25FFFFFF}" BorderThickness="1" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="32" ShadowDepth="6"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══ 상단 툴바 ══ -->
                <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="{DynamicResource TopBarGradient}"
                      SizeChanged="TitleBar_SizeChanged">
                    <!-- 하단 separator -->
                    <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Th_15FFFFFF}"/>
                    <Border Background="Transparent"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
                    <!-- 현재 버전. 내용·툴팁(업데이트 확인 결과)은 코드에서 채움. 여기를 끌어도 창이 옮겨짐 -->
                    <Border x:Name="VersionBadge" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0,0,0" Padding="9,3,9,4" CornerRadius="10"
                            Background="{DynamicResource Th_12FFFFFF}" BorderBrush="{DynamicResource Th_1AFFFFFF}" BorderThickness="1"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock x:Name="TxtVersion" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Th_FFA0A8C4}"/>
                    </Border>
                    <!-- 오른쪽 버튼들과 겹치면 코드(ArrangeTitle)에서 왼쪽 남는 공간 가운데로 옮김 -->
                    <StackPanel x:Name="TitleCenter" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                SizeChanged="TitleBar_SizeChanged">
                        <Button Style="{StaticResource ModernBtn}" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Width="38" Height="38" Click="BtnPrev_Click" FontSize="13" ToolTip="이전"/>
                        <TextBlock x:Name="TxtYearMonth" Text="2025. 11"
                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Th_FFE8ECF8}" Margin="14,0"
                                   VerticalAlignment="Center" Cursor="Hand"
                                   WindowChrome.IsHitTestVisibleInChrome="True"
                                   MouseLeftButtonDown="TxtYearMonth_MouseLeftButtonDown"
                                   ToolTip="클릭하면 오늘 날짜로 이동합니다.">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Button Style="{StaticResource ModernBtn}" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Width="38" Height="38" Click="BtnNext_Click" FontSize="13" ToolTip="다음"/>
                        <Button x:Name="BtnToday" Content="오늘" Click="BtnToday_Click"
                                Style="{StaticResource ModernBtn}"
                                FontSize="12" FontWeight="SemiBold"
                                Width="60" Height="28" Margin="16,0,0,0"
                                BorderBrush="{DynamicResource Th_405AC8FA}" BorderThickness="1"
                                Background="{DynamicResource Th_205AC8FA}" Foreground="{DynamicResource Th_FFC0D8F8}"
                                ToolTip="이번 달로 돌아가기"/>
                    </StackPanel>

                    <StackPanel x:Name="TitleToolbar" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,18,0" SizeChanged="TitleBar_SizeChanged">

                        <ToggleButton x:Name="BtnPrivacy"
                            Click="BtnPrivacy_Click"
                            Width="35" Margin="0,0,4,0"
                            ToolTip="프라이버시 모드: 일정 내용 가리기 (토글)"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                        Background="{DynamicResource Th.Privacy}"
                                        CornerRadius="8" Padding="4,2">
                                        <TextBlock x:Name="EyeIcon"
                                           Text="&#xE890;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Foreground="{DynamicResource Th.PrivacyIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="EyeIcon"  Property="Text"       Value="&#xED1A;"/>
                                            <Setter TargetName="border"   Property="Background" Value="{DynamicResource Th.PrivacyOn}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="EyeIcon"  Property="Text"       Value="&#xE890;"/>
                                            <Setter TargetName="border"   Property="Background" Value="{DynamicResource Th.Privacy}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Th.PrivacyHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- 고정 켜기/끄기 + 고정 위치(맨 뒤 ↔ 맨 앞)를 한 덩어리로. 틀은 옆 보기 전환 탭과 맞춤. 위치 버튼 선택 = 맨 앞, 툴팁은 코드에서 갱신.
                             고정 중에는 두 칸이 함께 한 장의 장미색 알약이 됨: 고정만 칠하면 위치 버튼이 별도 기능처럼 보임 (사용자: "고정하고 맨앞,맨뒤는 같은 그룹이기 때문에 디자인을 확실하게 해줘") -->
                        <Border x:Name="PinGroup" CornerRadius="8" Padding="2" Margin="0,0,8,0"
                                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Th_20FFFFFF}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ChkLockMinimize}" Value="True">
                                            <Setter Property="Background" Value="#E8476F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkLockMinimize"
                                    ToolTip="고정 (옆 버튼에서 고른 맨 앞/맨 뒤로 고정, 최소화되지 않음)"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Cursor="Hand">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="seg" Background="Transparent" CornerRadius="6" Padding="7,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="pinIcon" Text="&#xE718;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="12.5" Foreground="{DynamicResource Th_FFA0A8C4}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="pinLabel" Text="고정"
                                                       FontSize="11" Foreground="{DynamicResource Th_FFA0A8C4}"
                                                       VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="seg"      Property="Background" Value="{DynamicResource Th_18FFFFFF}"/>
                                                    <Setter TargetName="pinIcon"  Property="Foreground" Value="{DynamicResource Th_FFE0E4F4}"/>
                                                    <Setter TargetName="pinLabel" Property="Foreground" Value="{DynamicResource Th_FFE0E4F4}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="pinIcon"  Property="Text"       Value="&#xE842;"/>
                                                    <Setter TargetName="pinIcon"  Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter TargetName="pinLabel" Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter TargetName="pinLabel" Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="seg" Property="Background" Value="{DynamicResource Th_26FFFFFF}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                                <Rectangle Width="1" Margin="3,5">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{DynamicResource Th_30FFFFFF}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChkLockMinimize}" Value="True">
                                                    <Setter Property="Fill" Value="#70FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <!-- 누를 때마다 맨 뒤 ↔ 맨 앞 전환. 겹친 네모 중 칠해진 쪽이 이 창의 위치 -->
                                <ToggleButton x:Name="BtnPinMode" Click="BtnPinMode_Click"
                                              WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Foreground" Value="{DynamicResource Th_FFA0A8C4}"/>
                                            <Style.Triggers>
                                                <!-- 고정 중에만 또렷하게 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Th_FFFFFFFF}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChkLockMinimize}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="seg" Background="Transparent" CornerRadius="6" Padding="6,2,8,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Grid x:Name="iconBack">
                                                            <Path Fill="{TemplateBinding Foreground}"
                                                                  Data="M 2.5,1 H 7.5 A 1.5,1.5 0 0 1 9,2.5 V 4 H 6.5 A 2.5,2.5 0 0 0 4,6.5 V 9 H 2.5 A 1.5,1.5 0 0 1 1,7.5 V 2.5 A 1.5,1.5 0 0 1 2.5,1 Z"/>
                                                            <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1"
                                                                  Data="M 6.5,5 H 11.5 A 1.5,1.5 0 0 1 13,6.5 V 11.5 A 1.5,1.5 0 0 1 11.5,13 H 6.5 A 1.5,1.5 0 0 1 5,11.5 V 6.5 A 1.5,1.5 0 0 1 6.5,5 Z"/>
                                                        </Grid>
                                                        <Grid x:Name="iconFront" Visibility="Collapsed">
                                                            <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Data="M 5,9 H 2.5 A 1.5,1.5 0 0 1 1,7.5 V 2.5 A 1.5,1.5 0 0 1 2.5,1 H 7.5 A 1.5,1.5 0 0 1 9,2.5 V 5"/>
                                                            <Path Fill="{TemplateBinding Foreground}"
                                                                  Data="M 6.5,5 H 11.5 A 1.5,1.5 0 0 1 13,6.5 V 11.5 A 1.5,1.5 0 0 1 11.5,13 H 6.5 A 1.5,1.5 0 0 1 5,11.5 V 6.5 A 1.5,1.5 0 0 1 6.5,5 Z"/>
                                                        </Grid>
                                                    </Grid>
                                                    <TextBlock x:Name="modeLabel" Text="맨 뒤" FontSize="11"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="iconBack"  Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="iconFront" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="modeLabel" Property="Text"       Value="맨 앞"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="seg" Property="Background" Value="{DynamicResource Th_26FFFFFF}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="seg" Property="Background" Value="{DynamicResource Th_38FFFFFF}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                        </Border>

                        <!-- 보기 전환 탭 (월간 | 주간). 선택 상태는 코드에서 갱신 -->
                        <Border Background="{DynamicResource Th_20FFFFFF}" CornerRadius="8" Padding="2" Margin="0,0,4,0"
                                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border.Resources>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                                    <Setter Property="Cursor"     Value="Hand"/>
                                    <Setter Property="FontSize"   Value="11"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Th_FFA0A8C4}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="tab" Background="Transparent"
                                                        CornerRadius="6" Padding="9,2">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tab" Property="Background" Value="{DynamicResource Th_18FFFFFF}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Th_FFE0E4F4}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="tab" Property="Background" Value="{DynamicResource Th.SegSel}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Th.SegSelText}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Resources>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="BtnViewMonth" Content="월간" Click="BtnViewMode_Click" ToolTip="월간 보기"/>
                                <ToggleButton x:Name="BtnViewWeek" Content="주간" Click="BtnViewMode_Click" ToolTip="주간 보기 (이번 주만 표시)"/>
                            </StackPanel>
                        </Border>

                        <!-- 검색 버튼 (NEW) -->
                        <Button x:Name="BtnSearch" Style="{StaticResource ModernBtn}"
                                Content="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Th_FF5AC8FA}" FontSize="16"
                                Width="35" Click="BtnSearch_Click" ToolTip="일정 검색 (Ctrl+F)"/>
                        <!-- 매크로 버튼 (NEW) -->
                        <Button x:Name="BtnMacro" Style="{StaticResource ModernBtn}"
                                Content="&#xE8EE;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Th_FF2EC876}" FontSize="16"
                                Width="35" Click="BtnMacro_Click" ToolTip="반복 일정(매크로) 관리"/>

                        <!-- 라이트 / 다크 전환. 아이콘·색·툴팁은 코드(UpdateThemeButton)에서 -->
                        <Button x:Name="BtnTheme" Style="{StaticResource ModernBtn}"
                                FontFamily="{StaticResource IconFont}" FontSize="16"
                                Width="35" Click="BtnTheme_Click"/>
                        <Button x:Name="BtnSettings" Style="{StaticResource ModernBtn}"
                                Content="&#xE713;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Th_FFA270FA}" FontSize="16"
                                Width="35" Click="BtnSettings_Click" ToolTip="설정"/>
                        <Button Style="{StaticResource ModernBtn}" Content="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11" Width="35" Click="BtnMinimize_Click" ToolTip="최소화"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource ModernBtn}"
                                Content="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="11" Width="35" Click="BtnMaximize_Click"/>
                        <Button Width="35" Style="{StaticResource ModernBtn}"
                                Click="BtnClose_Click" Foreground="{DynamicResource Th_FFE05050}"
                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                ToolTip="트레이로 숨기기 (종료: 트레이 아이콘 우클릭 → 종료)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="5,3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}">
                                            <ContentPresenter.Content>&#xE8BB;</ContentPresenter.Content>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Th.CloseHover}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Th.ClosePressed}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ══ 요일 헤더 ══ -->
                <Border x:Name="WeekdayHeader" Grid.Row="1" Margin="12,6,12,0" CornerRadius="10"
                        Background="{DynamicResource HeaderGradient}"
                        BorderBrush="{DynamicResource Th_18FFFFFF}" BorderThickness="1">
                    <Grid x:Name="HeaderGrid" Margin="8,0,8,0">
                        <TextBlock x:Name="TxtHeaderSun" Text="일" Foreground="{DynamicResource Th_FFE06060}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="13">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtMon" Text="월" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Th_FF7880A0}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtTue" Text="화" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Th_FF7880A0}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtWed" Text="수" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Th_FF7880A0}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtThu" Text="목" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Th_FF7880A0}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtFri" Text="금" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Th_FF7880A0}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtHeaderSat" Text="토" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Th_FF4EB8E8}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ══ 달력 그리드 ══ -->
                <Border x:Name="CalendarCard" Grid.Row="2" Margin="12,6,12,12" CornerRadius="14"
                        Background="{DynamicResource CalendarBackgroundGradient}"
                        BorderBrush="{DynamicResource Th_15FFFFFF}" BorderThickness="1">
                    <Grid x:Name="CalendarGrid" Margin="6"/>
                </Border>

                <!-- ══ 설정 팝업 ══ -->
                <!-- 화면 · 달력 · 교대근무 · 창 순서로 구역마다 유리 카드 한 장. 자주 만지는 보기 설정이 위, 한 번 정하면 그만인 창·시스템 설정이 아래 -->
                <Border x:Name="SettingsPopup"
                        Grid.RowSpan="3"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="316" Margin="0,78,110,14" Padding="18,16,12,14"
                        CornerRadius="14" Visibility="Collapsed"
                        Background="{DynamicResource Th.PopupBg}"
                        BorderBrush="{DynamicResource Th_20FFFFFF}" BorderThickness="1"
                        MaxHeight="820">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" Opacity="0.65" ShadowDepth="8" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="0">
                            <Ellipse Width="26" Height="26" Fill="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4"
                                                      Color="{StaticResource AccentColor}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtSettingsHeader" Text="설정"
                                       FontWeight="Bold" Margin="8,0,0,0" FontSize="18"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Th_FFE0E4F4}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                            <StackPanel Margin="0,0,6,2" Grid.IsSharedSizeScope="True">

                                <!-- ── 화면 ── -->
                                <StackPanel Style="{StaticResource SettingSectionHeader}" Margin="4,10,0,7">
                                    <TextBlock Style="{StaticResource SettingSectionIcon}" Text="&#xE790;" Foreground="{DynamicResource Th_FFA270FA}"/>
                                    <TextBlock Style="{StaticResource SettingSectionTitle}" Text="화면"/>
                                </StackPanel>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SliderLabel"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtOpacityLabel" Text="투명도" Style="{StaticResource SettingLabel}"/>
                                            <Slider x:Name="SliderOpacity" Grid.Column="1" Style="{StaticResource SettingSlider}"
                                                    Minimum="0.2" Maximum="1.0"/>
                                            <TextBlock x:Name="TxtOpacityValue" Grid.Column="2" Text="90%" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource Th_FF7880A0}"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SliderLabel"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtFontSizeLabel" Text="글자 크기" Style="{StaticResource SettingLabel}"/>
                                            <Slider x:Name="SliderFontSize" Grid.Column="1" Style="{StaticResource SettingSlider}"
                                                    Minimum="10" Maximum="30" SmallChange="1" LargeChange="2"
                                                    IsSnapToTickEnabled="True"/>
                                            <TextBox x:Name="TxtFontSizeInput" Grid.Column="2" Style="{StaticResource SettingInput}"
                                                     Text="12" Width="32" Padding="0" HorizontalAlignment="Right"
                                                     TextAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock x:Name="TxtBulletLabel" Text="일정 기호" Style="{StaticResource SettingLabel}"/>
                                            <Border Style="{StaticResource SegmentGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ToggleButton x:Name="BtnStyle0" Content="•"  Tag="0" Click="BtnStyle_Click" Style="{StaticResource SegmentToggle}" MinWidth="32" FontSize="13"/>
                                                    <ToggleButton x:Name="BtnStyle1" Content="■"  Tag="1" Click="BtnStyle_Click" Style="{StaticResource SegmentToggle}" MinWidth="32" FontSize="10"/>
                                                    <ToggleButton x:Name="BtnStyle2" Content="-"  Tag="2" Click="BtnStyle_Click" Style="{StaticResource SegmentToggle}" MinWidth="32"/>
                                                    <ToggleButton x:Name="BtnStyle3" Content="1." Tag="3" Click="BtnStyle_Click" Style="{StaticResource SegmentToggle}" MinWidth="32"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ── 달력 ── -->
                                <StackPanel Style="{StaticResource SettingSectionHeader}">
                                    <TextBlock Style="{StaticResource SettingSectionIcon}" Text="&#xE787;" Foreground="{DynamicResource Th_FF5AC8FA}"/>
                                    <TextBlock Style="{StaticResource SettingSectionTitle}" Text="달력"/>
                                </StackPanel>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock x:Name="TxtWeekendsLabel" Text="주말 숨기기" Style="{StaticResource SettingLabel}"/>
                                            <CheckBox x:Name="BtnHideWeekends" Style="{StaticResource SettingSwitch}"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="전/후 월 표시" Style="{StaticResource SettingLabel}"/>
                                            <CheckBox x:Name="CalChkShowAdjacentMonths" Style="{StaticResource SettingSwitch}"
                                                      IsChecked="False"
                                                      Checked="CalChkShowAdjacentMonths_Changed"
                                                      Unchecked="CalChkShowAdjacentMonths_Changed"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="연속일정 연결" Style="{StaticResource SettingLabel}"/>
                                            <CheckBox x:Name="ChkConnectConsecutive" Style="{StaticResource SettingSwitch}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ── 교대근무 (4조) ── 켜야 아래 줄이 펼쳐짐. 근무는 근무 API 에서 (docs/shift-api.md) -->
                                <StackPanel Style="{StaticResource SettingSectionHeader}">
                                    <TextBlock Style="{StaticResource SettingSectionIcon}" Text="&#xE716;" Foreground="{DynamicResource Th_FFFFC94D}"/>
                                    <TextBlock Style="{StaticResource SettingSectionTitle}" Text="교대근무"/>
                                    <TextBlock Style="{StaticResource SettingHint}" Text="4조 3교대 · A · B · C · D조" Margin="8,1,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="교대근무 표시" Style="{StaticResource SettingLabel}"/>
                                            <CheckBox x:Name="ChkShiftEnabled" Style="{StaticResource SettingSwitch}"
                                                      Checked="ChkShiftEnabled_Changed" Unchecked="ChkShiftEnabled_Changed"/>
                                        </Grid>
                                        <StackPanel x:Name="ShiftDetails" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingDivider}"/>
                                            <Grid Style="{StaticResource SettingRow}">
                                                <TextBlock Text="표시할 조" Style="{StaticResource SettingLabel}"
                                                           ToolTip="여러 조를 고를 수 있습니다. 달력에는 A · B · C · D 자리를 그대로 두고 고른 조만 표시합니다"/>
                                                <Border Style="{StaticResource SegmentGroup}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ToggleButton x:Name="BtnShiftTeamAll" Content="전체" Tag="All" Click="BtnShiftTeam_Click" Style="{StaticResource SegmentToggle}"/>
                                                        <ToggleButton x:Name="BtnShiftTeamA" Content="A" Tag="A" Click="BtnShiftTeam_Click" Style="{StaticResource SegmentToggle}"/>
                                                        <ToggleButton x:Name="BtnShiftTeamB" Content="B" Tag="B" Click="BtnShiftTeam_Click" Style="{StaticResource SegmentToggle}"/>
                                                        <ToggleButton x:Name="BtnShiftTeamC" Content="C" Tag="C" Click="BtnShiftTeam_Click" Style="{StaticResource SegmentToggle}"/>
                                                        <ToggleButton x:Name="BtnShiftTeamD" Content="D" Tag="D" Click="BtnShiftTeam_Click" Style="{StaticResource SegmentToggle}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── 창 ── -->
                                <StackPanel Style="{StaticResource SettingSectionHeader}">
                                    <TextBlock Style="{StaticResource SettingSectionIcon}" Text="&#xE7F4;" Foreground="{DynamicResource Th_FF2EC876}"/>
                                    <TextBlock Style="{StaticResource SettingSectionTitle}" Text="창 · 시스템"/>
                                </StackPanel>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock Text="고정 시 드래그 잠금" Style="{StaticResource SettingLabel}"/>
                                            <CheckBox x:Name="ChkLockDrag" Style="{StaticResource SettingSwitch}"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <!-- 끄면 트레이 아이콘으로만 열기 -->
                                            <TextBlock Text="작업 표시줄에 표시" Style="{StaticResource SettingLabel}"
                                                       ToolTip="켜면 작업 표시줄·Alt+Tab 에 나오고, 끄면 트레이 아이콘으로만 열 수 있습니다"/>
                                            <CheckBox x:Name="ChkShowInTaskbar" Style="{StaticResource SettingSwitch}"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <TextBlock x:Name="TxtAutoStartLabel" Text="부팅 시 자동 실행" Style="{StaticResource SettingLabel}"/>
                                            <CheckBox x:Name="ChkAutoStart" Style="{StaticResource SettingSwitch}"
                                                      Click="ChkAutoStart_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
